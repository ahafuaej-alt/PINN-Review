{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource.schema.json",
  "title": "Computational resource inventory record",
  "type": "object",
  "required": ["resource_id","canonical_url","host","resource_type","owner","repository","preliminary_classification","classification_candidates","atlas_reference_ids","source_sections","source_lines","verification_status","ready_for_publication"],
  "properties": {
    "resource_id":{"type":"string","pattern":"^CR\\d{6}$"},
    "canonical_url":{"type":"string","minLength":1},
    "host":{"type":["string","null"]},
    "resource_type":{"type":"string","minLength":1},
    "owner":{"type":["string","null"]},
    "repository":{"type":["string","null"]},
    "preliminary_classification":{"type":"string","minLength":1},
    "classification_candidates":{"type":"array","items":{"type":"string"}},
    "atlas_reference_ids":{"type":"array","items":{"type":"integer","minimum":1,"maximum":853},"uniqueItems":true},
    "source_sections":{"type":"array","items":{"type":"string"}},
    "source_lines":{"type":"array","items":{"type":"integer","minimum":1,"maximum":648},"uniqueItems":true},
    "verification_status":{"const":"stage1_unverified"},
    "ready_for_publication":{"const":false}
  },
  "additionalProperties": false
}
