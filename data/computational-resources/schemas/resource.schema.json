{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource.schema.json",
  "title": "Computational resource inventory record",
  "type": "object",
  "required": [
    "resource_id",
    "canonical_url",
    "resource_type",
    "preliminary_classification",
    "verification_status",
    "ready_for_publication"
  ],
  "properties": {
    "resource_id": {
      "type": "string",
      "pattern": "^CR\\d{6}$"
    },
    "canonical_url": {
      "type": "string"
    },
    "host": {
      "type": [
        "string",
        "null"
      ]
    },
    "resource_type": {
      "type": "string"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "preliminary_classification": {
      "type": "string"
    },
    "classification_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "atlas_reference_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "source_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_seen_line": {
      "type": "integer",
      "minimum": 1
    },
    "verification_status": {
      "const": "stage1_unverified"
    },
    "ready_for_publication": {
      "const": false
    }
  },
  "additionalProperties": false
}
