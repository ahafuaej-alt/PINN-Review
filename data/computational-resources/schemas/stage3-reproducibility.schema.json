{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage3-reproducibility.schema.json",
  "title": "Stage 3 static reproducibility assessment",
  "type": "object",
  "required": ["schema_version", "resource_id", "components", "reproducibility_level", "reproducibility_gaps", "assessment_evidence_ids", "assessment_status"],
  "properties": {
    "schema_version": {"const": "3.0.0-pilot"},
    "resource_id": {"$ref": "stage3-common.schema.json#/$defs/resourceId"},
    "experiment_id": {"anyOf": [{"$ref": "stage3-common.schema.json#/$defs/experimentId"}, {"type": "null"}]},
    "configuration_id": {"anyOf": [{"$ref": "stage3-common.schema.json#/$defs/configurationId"}, {"type": "null"}]},
    "components": {
      "type": "object",
      "required": ["source_available", "license_clear", "environment_specified", "versions_pinned", "installation_documented", "entrypoint_identified", "data_available", "preprocessing_documented", "mathematics_documented", "architecture_documented", "training_documented", "hyperparameters_documented", "seeds_reported", "hardware_reported", "evaluation_documented", "expected_results_documented", "checkpoints_available", "citation_available"],
      "properties": {
        "source_available": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "license_clear": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "environment_specified": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "versions_pinned": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "installation_documented": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "entrypoint_identified": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "data_available": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "preprocessing_documented": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "mathematics_documented": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "architecture_documented": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "training_documented": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "hyperparameters_documented": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "seeds_reported": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "hardware_reported": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "evaluation_documented": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "expected_results_documented": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "checkpoints_available": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"},
        "citation_available": {"$ref": "stage3-common.schema.json#/$defs/fieldStatus"}
      },
      "additionalProperties": false
    },
    "reproducibility_level": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "reproducibility_gaps": {"type": "array", "items": {"type": "string"}},
    "assessment_evidence_ids": {"type": "array", "items": {"$ref": "stage3-common.schema.json#/$defs/evidenceId"}, "uniqueItems": true},
    "assessment_status": {"enum": ["verified_static_assessment", "partially_verified_static_assessment", "bounded_static_assessment"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
