  screening_roles text
  quality_appraisal_method text
  risk_of_bias_method text
  certainty_assessment_method text
  origin_class varchar [not null]
  verification_status varchar [not null]
  ontology_version varchar [not null]
}

Table review_scope_items {
  review_scope_item_id varchar [pk]
  review_scope_id varchar [not null]
  item_role varchar [not null, note: 'domain|problem_family|task|method_family|source|analysis_method']
  item_value text [not null]
  taxonomy_term_id varchar
}

Table evidence {
  evidence_id varchar [pk]
  paper_id varchar [not null]
  source_artifact_id varchar
  evidence_category varchar [not null]
  linked_entity_type varchar [not null]
  linked_record_id varchar [not null]
  normalized_statement text [not null]
  verbatim_evidence text [not null, note: 'Immutable after capture']
  source_section text [not null]
  source_subsection text
  page varchar
  paragraph varchar
  figure varchar
  table_locator varchar
  appendix varchar
  scope_locator text
  evidence_type varchar [not null]
  statement_strength varchar [not null]
  origin_class varchar [not null]
  evidence_source_role varchar [not null]
  verification_status varchar [not null]
  support_status varchar [not null]
  verified_by varchar
  verification_date datetime
  verification_notes text
  ontology_version varchar [not null]
}

Table evidence_classification_history {
  evidence_history_id varchar [pk]
