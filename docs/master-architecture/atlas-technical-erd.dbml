Project PINN_Review_Atlas_Technical_ERD {
  database_type: 'Provider-neutral relational model'
  Note: '''
  Task 2.4 technical ERD. Scientific authority remains locked Drive v0.7-pilot-atlas-prefreeze.
  This DBML is an implementation serialization contract, not a new ontology version.
  IDs use provider-neutral varchar placeholders; concrete SQL types, indexes, triggers, partitioning,
  RLS, generated columns, search infrastructure, and provider extensions are deferred.
  Polymorphic scientific links are governed by entity_type + record_id plus QA because DBML cannot
  express cross-table polymorphic foreign keys.
  '''
}

Table source_artifacts {
  source_artifact_id varchar [pk]
  artifact_type varchar [not null]
  source_role varchar [not null]
  title_or_label text
  source_uri_or_drive_reference text
  access_state varchar [not null]
  content_version_or_fingerprint varchar
  retrieved_or_associated_at datetime
  source_notes text
}

Table paper_sources {
  paper_source_id varchar [pk]
  paper_id varchar [not null]
  source_artifact_id varchar [not null]
  association_role varchar [not null]
  is_primary_full_text boolean
  association_verification_status varchar [not null]
  association_provenance text
}

Table papers {
  paper_id varchar [pk]
  atlas_reference_id varchar [not null, unique]
  title text [not null]
  publication_year int [not null]
  doi varchar
  bibliographic_link text
  publication_document_type varchar [not null]
  publisher_article_label text
  record_version varchar [not null]
  canonical_normalization_version varchar [not null]
  corpus_status varchar
}

Table paper_authors {
  paper_author_id varchar [pk]
  paper_id varchar [not null]
  author_order int [not null]
  author_name text [not null]
  persistent_author_id varchar
}

Table paper_bibliographic_metadata {
  paper_id varchar [pk]
  venue text
  publisher text
  publication_type varchar
  access_state varchar
  bibliographic_verification_status varchar
  bibliographic_verified_by varchar
  bibliographic_verified_at datetime
  unresolved_bibliographic_conflict text
}

Table bibliographic_history {
  history_id varchar [pk]
  paper_id varchar [not null]
  field_name varchar [not null]
  old_value text
  new_value text
  change_reason text [not null]
  source_reference text
  reviewed_by varchar
  changed_at datetime [not null]
  verification_status varchar [not null]
  downstream_rebuild_status varchar
}

Table paper_study_design_components {
  paper_study_design_component_id varchar [pk]
  paper_id varchar [not null]
  component_key varchar [not null]
  component_scope text
