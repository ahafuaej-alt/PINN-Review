  support_role varchar [not null, note: 'derived_from|supporting|contradictory']
}

Table framework_definitions {
  framework_id varchar [pk]
  framework_key varchar [not null, unique]
  framework_name text [not null]
  framework_type varchar [not null]
  purpose text [not null]
  status varchar [not null]
  synthesis_version varchar [not null]
}

Table framework_nodes {
  framework_node_id varchar [pk]
  framework_id varchar [not null]
  node_key varchar [not null]
  node_label text [not null]
  semantic_role varchar
  scope_context text
}

Table framework_edges {
  framework_edge_id varchar [pk]
  framework_id varchar [not null]
  source_node_id varchar [not null]
  target_node_id varchar [not null]
  edge_semantics text [not null]
  scope_context text
  confidence varchar
  synthesis_status varchar [not null]
}

Table framework_edge_support {
  framework_edge_support_id varchar [pk]
  framework_edge_id varchar [not null]
  paper_id varchar
  evidence_id varchar
  support_role varchar [not null]
}

Table design_performance_cells {
  cell_id varchar [pk]
  framework_id varchar [not null]
  design_variable varchar [not null]
  performance_dimension varchar [not null]
  qualitative_influence_classification varchar [not null]
  scope_context text
  tradeoff_notes text
  synthesis_version varchar [not null]
  review_status varchar [not null]
}

Table design_performance_cell_support {
  cell_support_id varchar [pk]
  cell_id varchar [not null]
  paper_id varchar
  evidence_id varchar
  support_role varchar [not null]
}

Table diagnostic_synthesis_items {
  diagnostic_synthesis_id varchar [pk]
  framework_id varchar [not null]
  diagnostic_category varchar [not null]
  diagnostic_mode varchar
  normalized_semantics text [not null]
  recommendation text
  synthesis_version varchar [not null]
}

Table diagnostic_synthesis_support {
  diagnostic_synthesis_support_id varchar [pk]
  diagnostic_synthesis_id varchar [not null]
  diagnostic_id varchar
  paper_id varchar
  evidence_id varchar
  support_role varchar [not null]
}

Table surface_registry {
  surface_id varchar [pk]
  route_or_family varchar [not null]
  title text [not null]
  purpose text [not null]
  audience varchar
  surface_class varchar [not null]
  current_or_future varchar [not null]
  source_authority_summary text [not null]
  evidence_provenance_requirement text
  lifecycle_state varchar [not null]
  target_disposition varchar
  task9_audit_status varchar [not null]
}

Table surface_dependencies {
  surface_dependency_id varchar [pk]
  surface_id varchar [not null]
  upstream_object_type varchar [not null]
  upstream_object_id varchar
  dependency_type varchar [not null]
  regeneration_requirement text
  regression_requirement text
}

Table interface_registry {
  interface_id varchar [pk]
  interface_type varchar [not null, note: 'API|view|export|search_index|machine_consumer']
  interface_name text [not null]
  version varchar [not null]
  purpose text [not null]
  upstream_authority text [not null]
  provenance_returned boolean [not null]
  compatibility_policy text
  status varchar [not null]
}

Table review_requests {
  review_request_id varchar [pk]
  requested_object_type varchar [not null]
  requested_object_id varchar
  proposal_type varchar [not null]
  requested_by varchar
  requested_at datetime
  review_status varchar [not null]
  disposition text
  owning_authority varchar [not null]
}

Table bounded_subsystems {
  subsystem_id varchar [pk]
  subsystem_key varchar [not null, unique]
  subsystem_name text [not null]
  independent_authority_reference text [not null]
  current_version varchar
  integration_policy text [not null]
  status varchar [not null]
}

Table subsystem_entity_links {
  subsystem_entity_link_id varchar [pk]
  subsystem_id varchar [not null]
  atlas_paper_id varchar
  atlas_entity_type varchar
  atlas_entity_id varchar
  subsystem_entity_type varchar [not null]
  subsystem_entity_id varchar [not null]
  relationship_semantics varchar [not null]
  evidence_or_provenance_reference text
  verification_status varchar [not null]
}

Table authority_registry {
  authority_id varchar [pk]
  authority_key varchar [not null, unique]
  scope text [not null]
  current_authoritative_version varchar [not null]
  owner_document_or_location text [not null]
  precedence_rule text [not null]
  status varchar [not null]
}

Table requirement_registry {
  requirement_id varchar [pk]
  source_contract varchar [not null]
  description text [not null]
  owning_layer varchar [not null]
  owning_authority varchar
  implementation_status varchar [not null]
}

Table qa_test_registry {
  qa_test_id varchar [pk]
  test_key varchar [not null, unique]
  test_class varchar [not null]
  description text [not null]
  pass_criteria text [not null]
  hard_gate boolean [not null]
}

Table qa_test_requirements {
  qa_test_requirement_id varchar [pk]
  qa_test_id varchar [not null]
  requirement_id varchar [not null]
}

Table qa_runs {
  qa_run_id varchar [pk]
  qa_test_id varchar [not null]
  object_type varchar
  object_id varchar
  run_version varchar
  result varchar [not null]
  evidence_log_reference text
  run_at datetime [not null]
  disposition text
}

Table human_reviews {
  review_id varchar [pk]
  object_type varchar [not null]
  object_id varchar [not null]
  reviewer varchar [not null]
  review_state varchar [not null]
  decision varchar
  review_notes text
  reviewed_at datetime
  next_required_action text
}

Table version_registry {
  version_id varchar [pk]
  version_type varchar [not null]
  version_key varchar [not null]
  parent_version_id varchar
  status varchar [not null]
  effective_date datetime
  changelog_reference text
  migration_required boolean [not null]
}

Table migrations {
  migration_id varchar [pk]
  migration_type varchar [not null]
  owner_layer varchar [not null]
  from_version_id varchar
  to_version_id varchar [not null]
  description text [not null]
  rollback_plan text [not null]
  approval_state varchar [not null]
  qa_status varchar [not null]
}

Table migration_impacts {
  migration_impact_id varchar [pk]
  migration_id varchar [not null]
  impacted_object_type varchar [not null]
  impacted_object_id varchar
  required_action text [not null]
  completion_status varchar [not null]
}

Table batches {
  batch_id varchar [pk]
  batch_type varchar [not null]
  ontology_version varchar [not null]
  data_version varchar
  extraction_review_state varchar [not null]
  hard_gate_status varchar [not null]
  clean_mapping_rate decimal
  active_major_structural_gaps int [not null]
  disposition varchar [not null, note: 'GO|CONDITIONAL_GO|STOP|ROLLBACK_REQUIRED']
  checkpoint_at datetime
}

Table batch_papers {
  batch_paper_id varchar [pk]
  batch_id varchar [not null]
  paper_id varchar [not null]
  paper_status varchar [not null]
}

Table correction_history {
  correction_id varchar [pk]
  object_type varchar [not null]
  object_id varchar [not null]
  field_name varchar
  old_value text
  new_value text
  reason text [not null]
  source_reference text
  reviewed_by varchar
  corrected_at datetime [not null]
  rollback_target text
  downstream_status varchar
}

Table dependency_edges {
  dependency_edge_id varchar [pk]
  source_object_type varchar [not null]
  source_object_id varchar [not null]
  dependent_object_type varchar [not null]
  dependent_object_id varchar [not null]
  dependency_type varchar [not null]
  last_synchronized_version varchar
  regression_required boolean [not null]
}

Table role_registry {
  role_id varchar [pk]
  role_key varchar [not null, unique]
  description text [not null]
}

Table role_permissions {
  role_permission_id varchar [pk]
  role_id varchar [not null]
  permission_scope varchar [not null]
  permission_action varchar [not null]
  authoritative_write_allowed boolean [not null]
  approval_requirement text
}

Table knowledge_builds {
  build_id varchar [pk]
  build_type varchar [not null]
  definition_version varchar [not null]
  exact_input_versions text [not null]
  exact_transformation_or_query text [not null]
  generated_at datetime [not null]
  output_reference text
  qa_status varchar [not null]
  reproducibility_notes text
}

